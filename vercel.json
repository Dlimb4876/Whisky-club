{
  "buildCommand": "npm install",
  "functions": {
    "api/gemini-search.js": {
      "runtime": "nodejs18.x"
    },
    "api/price-scrape.js": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ]
}
